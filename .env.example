# ==========================================
# NOFFICE - VISION AI OCR CONFIGURATION
# ==========================================

# Vision AI Provider Options: 'gemini' | 'openai' | 'anthropic'
VISION_PROVIDER=gemini

# Vision AI Model Name:
# Catatan: ganti ke model Flash terbaru yang aktif di dokumentasi Google AI (rekomendasi: gemini-flash-lite-latest untuk latensi terendah & stabilitas tanpa 503)
# - Google Gemini: 'gemini-flash-lite-latest', 'gemini-3.5-flash'
# - OpenAI: 'gpt-4o-mini', 'gpt-4o'
# - Anthropic Claude: 'claude-3-5-sonnet-20241022', 'claude-3-5-haiku-20241022'
VISION_MODEL=gemini-flash-lite-latest

# API Key for chosen Vision AI provider (SECRET: Kept on backend only)
VISION_API_KEY=your_api_key_here

# Request timeout in milliseconds (default: 25000 = 25 seconds)
VISION_TIMEOUT_MS=25000

# Rate limit: Maximum KTP extraction requests per user per minute (default: 10)
KTP_RATE_LIMIT_PER_MINUTE=10

# Mode Verifikasi NIK: Jika NIK tidak lolos validasi, ulangi pemanggilan Vision AI 1 kali (true/false)
KTP_VERIFY_NIK=true

